# TradeGuardian application security. Both values are required.
# APP_PASSWORD must be at least 10 characters. Use a unique password.
APP_PASSWORD=
# APP_SECRET must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Keep it stable: changing it makes the encrypted state unreadable.
APP_SECRET=

# Zerodha Kite Connect application credentials (server-side only).
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3000/
KITE_BASE_URL=https://api.kite.trade

# HTTP service and browser security.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Enable only when the service is directly behind a trusted reverse proxy.
TRUST_PROXY=false
AUTH_COOKIE_NAME=tradeguardian_session
AUTH_TTL_MS=43200000

# Optional HTTPS JSON webhook for trip, critical-failure, recovery, and flat alerts.
# The payload includes a Slack-compatible `text` plus a structured `event`.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=3000

# Encrypted guard state with fail-closed startup recovery. The parent directory
# must be durable and writable; runtime write failures are reported CRITICAL.
STATE_FILE=.data/state.json

# Initial risk settings. They can be changed in the UI only while unlocked;
# a connected, monitoring guard evaluates saved changes immediately.
MAX_LOSS=10000
PNL_POLL_MS=2000
GUARD_POLL_MS=1000
MARKET_PROTECTION=-1
# The requested safety policy is to flatten every non-zero Kite position.
# Narrow this only if you intentionally accept excluded exposure.
FLATTEN_PRODUCTS=ALL
CANCEL_GTT_ON_KILL=true
CHARGE_BUFFER=0

# Kite request/reconciliation safety timings.
KITE_REQUEST_TIMEOUT_MS=5000
EXIT_ORDER_MAX_AGE_MS=15000
SETTLEMENT_GRACE_MS=4000
